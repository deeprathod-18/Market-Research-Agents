# ---- LLM provider -------------------------------------------------------
# One of: mock | openai | anthropic | groq | gemini | openrouter | ollama
# "mock" runs fully offline with canned data (demo and tests only).
LLM_PROVIDER=groq

# Optional: override the default model for the chosen provider
# LLM_MODEL=gemini-3.8-flash

# Provide ONLY the key for the provider you chose
GROQ_API_KEY=your_groq_api_key_here
# Ollama needs no key; default base URL is http://localhost:11434/v1

# ---- Tools --------------------------------------------------------------
# ddgs (live web search) | mock (offline fixtures)
SEARCH_BACKEND=ddgs
# yfinance (live market data) | mock (synthetic demo data)
FINANCE_BACKEND=yfinance

# ---- Pipeline behaviour -------------------------------------------------
MAX_RESULTS_PER_QUERY=5
MIN_SOURCES=8
MIN_FINDINGS=8
MAX_RESEARCH_ATTEMPTS=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2500
OUTPUT_DIR=outputs

# Optional cost tracking (USD per 1M tokens) used in the evaluation report
PRICE_PER_1M_INPUT=0
PRICE_PER_1M_OUTPUT=0
